deploy.steps[0]: {"name": "Ref denetimi (yalnız yayın dalı yayınlanır)", "env": {"YAYIN_DALI": "claude/hopeful-cray-o1jw6w"}, "run": "test \"$GITHUB_REF\" = \"refs/heads/$YAYIN_DALI\" || { echo \"::error::Yalnız $YAYIN_DALI yayınlanır ($GITHUB_REF)\"; exit 1; }"}
