# PyYAML 6.0.3 yaml.safe_load ile .github/workflows/pages.yml (Y9a sonrası)
ayrıştırıldı: evet; üst anahtarlar: ['name', 'permissions', 'concurrency', 'jobs', 'on']
on: {"push": {"branches": ["main", "master", "claude/hopeful-cray-o1jw6w"]}, "workflow_dispatch": null}
jobs: ['check', 'deploy']
concurrency: {"group": "pages", "cancel-in-progress": false}
