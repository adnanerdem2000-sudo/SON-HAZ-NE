----- durum_karsilastir.py
import json, re, collections, sys
kok = "/home/user/SON-HAZ-NE-w2/"
md = open(kok+"docs/v05/raporlar/KNOWN_ISSUES.md", encoding="utf8").read().splitlines()
d = json.load(open(kok+"docs/v05/raporlar/durum.json", encoding="utf8"))
rows = {}
dup = []
for ln in md:
    if not ln.startswith("| KI-"): continue
    # split on unescaped |
    cells = [c.strip() for c in re.split(r'(?<!\\)\|', ln)[1:-1]]
    if len(cells) != 8: print("HUCRE SAYISI", len(cells), ln[:80]); continue
    kid = cells[0]
    if kid in rows: dup.append(kid)
    rows[kid] = dict(baslik=cells[1], oncelik=cells[2], alan=cells[3], dosya=cells[4], faz=cells[5], durum=cells[6], kaynak=cells[7])
print("md satir:", len(rows), "yinelenen:", dup)
S = d["sorunlar"]
print("json sorun:", len(S))
print("md'de olup json'da olmayan:", sorted(set(rows)-set(S)))
print("json'da olup md'de olmayan:", sorted(set(S)-set(rows)))
onc = collections.Counter(r["oncelik"] for r in rows.values())
print("md oncelik:", dict(onc))
def birincil(f):
    m = re.search(r'Faz\s*(\d)', f); return int(m.group(1)) if m else None
fz = collections.Counter(birincil(r["faz"]) for r in rows.values())
print("md birincil faz:", dict(sorted(fz.items(), key=lambda x: (x[0] is None, x[0]))))
durum = collections.Counter(r["durum"] for r in rows.values())
print("md durum:", dict(durum))
# alan bazli karsilastirma
farklar = collections.defaultdict(list)
for k, r in rows.items():
    j = S.get(k)
    if not j: continue
    if j.get("oncelik") != r["oncelik"]: farklar["oncelik"].append((k, r["oncelik"], j.get("oncelik")))
    if j.get("fazMetni") != r["faz"]: farklar["fazMetni"].append((k, r["faz"], j.get("fazMetni")))
    if j.get("faz") != birincil(r["faz"]): farklar["faz"].append((k, r["faz"], j.get("faz")))
    ek = sorted(set(int(x) for x in re.findall(r'Faz\s*(\d)', r["faz"])) - {birincil(r["faz"])})
    if sorted(j.get("fazEk") or []) != ek: farklar["fazEk"].append((k, r["faz"], j.get("fazEk")))
    if j.get("baslik") != r["baslik"]: farklar["baslik"].append((k, r["baslik"][:60], (j.get("baslik") or "")[:60]))
    if j.get("dosya") != r["dosya"]: farklar["dosya"].append((k, r["dosya"], j.get("dosya")))
    alanlar = [a.strip() for a in r["alan"].split(",")]
    if j.get("alan") != alanlar: farklar["alan"].append((k, r["alan"], j.get("alan")))
    if j.get("durum") != "acik": farklar["durum"].append((k, j.get("durum")))
for f, v in farklar.items():
    print("FARK", f, len(v)); [print("   ", x) for x in v[:12]]
oz = d["ozet"]
print("ozet:", json.dumps(oz, ensure_ascii=False))
jo = collections.Counter(v["oncelik"] for v in S.values()); jf = collections.Counter(v["faz"] for v in S.values())
print("json'dan sayilan oncelik:", dict(jo)); print("json'dan sayilan faz:", dict(sorted(jf.items())))
