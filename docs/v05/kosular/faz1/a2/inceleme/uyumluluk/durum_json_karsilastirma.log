import json, re, subprocess
kok = "/home/user/SON-HAZ-NE-w2/"
md = open(kok+"docs/v05/raporlar/KNOWN_ISSUES.md", encoding="utf8").read().splitlines()
eski = subprocess.run(["git","-C",kok,"show","5479e3b:docs/v05/raporlar/KNOWN_ISSUES.md"],capture_output=True,text=True).stdout.splitlines()
d = json.load(open(kok+"docs/v05/raporlar/durum.json", encoding="utf8"))["sorunlar"]
def satirlar(L):
    out = {}
    for ln in L:
        if not ln.startswith("| KI-"): continue
        c = [x.strip() for x in re.split(r'(?<!\\)\|', ln)[1:-1]]
        if len(c) == 8: out[c[0]] = c
    return out
R = satirlar(md); R.update({k:v for k,v in satirlar(eski).items() if k not in R})
ID = r'[A-K]-(?:M)?\d+|B-M\d+|[A-K]-M\d+'
fark = []
for k, c in R.items():
    kaynak = c[7].split(" / eski:")[0]
    parcalar = [p.strip() for p in kaynak.split(";")]
    den, ilg = [], []
    for p in parcalar:
        m = re.match(r'(ilgili:\s*)?([A-K]-(?:M)?\d+)', p)
        if not m: continue
        (ilg if m.group(1) else den).append(m.group(2))
    j = d[k]
    if j["denetim"] != den or j["ilgili"] != ilg:
        fark.append((k, den, ilg, j["denetim"], j["ilgili"], kaynak[:120]))
print("kaynak sütunu farkı:", len(fark))
for f in fark[:15]: print(" ", f)
