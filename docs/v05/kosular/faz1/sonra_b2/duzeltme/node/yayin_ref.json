 "ayristirilan": {
  "name": "GitHub Pages",
  "on": {
   "push": {
    "branches": [
     "main",
     "master",
     "claude/hopeful-cray-o1jw6w"
    ]
   },
   "workflow_dispatch": null
  },
  "permissions": {
   "contents": "read",
   "pages": "write",
   "id-token": "write"
  },
  "concurrency": {
   "group": "pages",
   "cancel-in-progress": false
  },
  "jobs": {
   "check": {
    "runs-on": "ubuntu-latest",
    "outputs": {
     "enabled": "${{ steps.pages.outputs.enabled }}"
    },
    "steps": [
     {
      "id": "pages",
      "env": {
       "GH_TOKEN": "${{ github.token }}"
      },
      "run": "code=$(curl -s -o /dev/null -w '%{http_code}' -H \"Authorization: Bearer $GH_TOKEN\" -H \"Accept: application/vnd.github+json\" \"https://api.github.com/repos/${{ github.repository }}/pages\")\nif [ \"$code\" = \"200\" ]; then echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"; else echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"; echo \"::notice::GitHub Pages bu depoda henüz açık değil (Settings → Pages → Source: GitHub Actions). Yayın atlandı.\"; fi\n"
     }
    ]
   },
   "deploy": {
    "needs": "check",
    "if": "needs.check.outputs.enabled == 'true' && github.ref == 'refs/heads/claude/hopeful-cray-o1jw6w'",
    "runs-on": "ubuntu-latest",
    "environment": {
     "name": "github-pages",
     "url": "${{ steps.deployment.outputs.page_url }}"
    },
    "steps": [
     {
      "name": "Ref denetimi (yalnız yayın dalı yayınlanır)",
      "env": {
       "YAYIN_DALI": "claude/hopeful-cray-o1jw6w"
      },
      "run": "test \"$GITHUB_REF\" = \"refs/heads/$YAYIN_DALI\" || { echo \"::error::Yalnız $YAYIN_DALI yayınlanır ($GITHUB_REF)\"; exit 1; }"
     },
     {
      "uses": "actions/checkout@v4"
     },
     {
      "uses": "actions/configure-pages@v5"
     },
     {
      "name": "Tek dosya HTML sürümü",
      "run": "npm i --prefix \"$RUNNER_TEMP/esb\" --no-audit --no-fund esbuild@0.24.2\nNODE_PATH=\"$RUNNER_TEMP/esb/node_modules\" node tools/build-single-html.mjs DenizKorsanlari-SonHazine.html\n"
     },
     {
      "uses": "actions/upload-pages-artifact@v3",
      "with": {
       "path": "."
      }
     },
     {
      "id": "deployment",
      "uses": "actions/deploy-pages@v4"
     }
    ]
   }
  }
 }
}